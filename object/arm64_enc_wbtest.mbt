///|
// Every encoder form is checked against clang's own encoding of the same
// instruction. Reference words were produced by `clang -c` + `otool`.

///|
fn check_word(actual : Int, expected : Int64) -> Unit raise {
  assert_eq(actual.to_int64() & 0xFFFFFFFFL, expected)
}

///|
test "arm64 enc: integer data processing" {
  check_word(enc_add_reg(0, 1, 2), 0x8B020020L)
  check_word(enc_add_imm(0, 1, 100), 0x91019020L)
  check_word(enc_sub_reg(0, 1, 2), 0xCB020020L)
  check_word(enc_sub_imm(0, 1, 100), 0xD1019020L)
  check_word(enc_and_reg(0, 1, 2), 0x8A020020L)
  check_word(enc_orr_reg(0, 1, 2), 0xAA020020L)
  check_word(enc_eor_reg(0, 1, 2), 0xCA020020L)
  check_word(enc_asr(0, 1, 2), 0x9AC22820L)
  check_word(enc_lsr(0, 1, 2), 0x9AC22420L)
  check_word(enc_lsl(0, 1, 2), 0x9AC22020L)
  check_word(enc_mul(0, 1, 2), 0x9B027C20L)
  check_word(enc_sdiv(0, 1, 2), 0x9AC20C20L)
  check_word(enc_udiv(0, 1, 2), 0x9AC20820L)
  check_word(enc_msub(0, 1, 2, 3), 0x9B028C20L)
  check_word(enc_mov_reg(0, 1), 0xAA0103E0L)
  check_word(enc_movz(0, 42, 0), 0xD2800540L)
  check_word(enc_movk(0, 1, 1), 0xF2A00020L)
  check_word(enc_cmp(0, 1), 0xEB01001FL)
  check_word(enc_cmn(0, 1), 0xAB01001FL)
  check_word(enc_sxtb(0, 1), 0x93401C20L)
  check_word(enc_sxth(0, 1), 0x93403C20L)
  check_word(enc_sxtw(0, 1), 0x93407C20L)
  check_word(enc_uxtb(0, 1), 0x53001C20L)
  check_word(enc_uxth(0, 1), 0x53003C20L)
  check_word(enc_add_imm(31, 31, 16), 0x910043FFL)
  check_word(enc_sub_imm(31, 31, 16), 0xD10043FFL)
  check_word(enc_adrp(0, 0), 0x90000000L)
  check_word(enc_adrp(1, 1), 0xB0000001L)
  check_word(enc_adrp(2, 2048), 0x90004002L)
  check_word(enc_adrp(17, 1), 0xB0000011L)
  check_word(enc_cset(false, 0, 0), 0x1A9F17E0L)
  check_word(enc_cset(true, 0, 1), 0x9A9F07E0L)
  check_word(enc_cset(false, 5, 12), 0x1A9FD7E5L)
  check_word(enc_cset(false, 3, 10), 0x1A9FB7E3L)
  check_word(enc_cset(false, 9, 8), 0x1A9F97E9L)
  check_word(enc_cset(false, 2, 3), 0x1A9F27E2L)
  check_word(enc_csinc(false, 0, 31, 31, 0), 0x1A9F07E0L)
  check_word(enc_csinc(true, 0, 31, 31, 1), 0x9A9F17E0L)
  // 32-bit (w) class-aware forms, clang references
  check_word(enc_add_reg_sf(false, 0, 1, 2), 0x0B020020L)
  check_word(enc_sub_reg_sf(false, 0, 1, 2), 0x4B020020L)
  check_word(enc_and_reg_sf(false, 0, 1, 2), 0x0A020020L)
  check_word(enc_orr_reg_sf(true, 0, 1, 2), 0xAA020020L)
  check_word(enc_eor_reg_sf(false, 0, 1, 2), 0x4A020020L)
  check_word(enc_mov_reg_sf(false, 0, 1), 0x2A0103E0L)
  check_word(enc_lsl_sf(false, 0, 1, 2), 0x1AC22020L)
  check_word(enc_lsr_sf(false, 0, 1, 2), 0x1AC22420L)
  check_word(enc_asr_sf(false, 0, 1, 2), 0x1AC22820L)
  check_word(enc_sdiv_sf(false, 0, 1, 2), 0x1AC20C20L)
  check_word(enc_udiv_sf(false, 0, 1, 2), 0x1AC20820L)
  check_word(enc_mul_sf(false, 0, 1, 2), 0x1B027C20L)
  check_word(enc_msub_sf(false, 0, 1, 2, 3), 0x1B028C20L)
  check_word(enc_cmp_sf(false, 0, 1), 0x6B01001FL)
  check_word(enc_cmn_sf(false, 0, 1), 0x2B01001FL)
  check_word(enc_movz_sf(false, 0, 42, 0), 0x52800540L)
  check_word(enc_movk_sf(false, 0, 1, 1), 0x72A00020L)
  check_word(enc_cmp_imm_sf(false, 0, 0), 0x7100001FL)
  check_word(enc_cmn_imm_sf(false, 0, 1), 0x3100041FL)
  check_word(enc_add_imm_sf(false, 0, 1, 100), 0x11019020L)
  check_word(enc_sub_imm_sf(true, 0, 1, 100), 0xD1019020L)
}

///|
test "arm64 enc: loads and stores" {
  check_word(enc_ldr_x(0, 1, 0), 0xF9400020L)
  check_word(enc_ldr_x(0, 1, 8), 0xF9400420L)
  check_word(enc_str_x(0, 1, 8), 0xF9000420L)
  check_word(enc_ldrb(0, 1, 0), 0x39400020L)
  check_word(enc_strb(0, 1, 0), 0x39000020L)
  check_word(enc_ldrsw(0, 1, 0), 0xB9800020L)
  check_word(enc_ldp(0, 1, 2, 0), 0xA9400440L)
  check_word(enc_stp_pre(0, 1, 2, -16), 0xA9BF0440L)
  check_word(enc_ldp_post(0, 1, 2, 16), 0xA8C10440L)
  check_word(enc_ldst_fp(2, 1, 0, 1, 0), 0xBD400020L)
  check_word(enc_ldst_fp(3, 1, 0, 1, 0), 0xFD400020L)
  check_word(enc_ldst_fp(2, 0, 0, 1, 0), 0xBD000020L)
  check_word(enc_ldst_fp(3, 0, 0, 1, 0), 0xFD000020L)
}

///|
test "arm64 enc: branches and misc" {
  check_word(enc_ret(), 0xD65F03C0L)
  check_word(enc_hint(34), 0xD503245FL)
  check_word(enc_nop(), 0xD503201FL)
}

///|
test "arm64 enc: floating point" {
  check_word(enc_fadd_d(0, 1, 2), 0x1E622820L)
  check_word(enc_fsub_d(0, 1, 2), 0x1E623820L)
  check_word(enc_fmul_d(0, 1, 2), 0x1E620820L)
  check_word(enc_fdiv_d(0, 1, 2), 0x1E621820L)
  check_word(enc_fcmp_d(0, 1), 0x1E612000L)
  check_word(enc_fcvtzs_x_d(0, 0), 0x9E780000L)
  check_word(enc_scvtf_d_x(0, 0), 0x9E620000L)
  check_word(enc_fmov_d(0, 1), 0x1E604020L)
  check_word(enc_fmov_x_d(0, 0), 0x9E660000L)
  check_word(enc_fcvt_d_s(0, 1), 0x1E22C020L)
  check_word(enc_fadd_s(0, 1, 2), 0x1E222820L)
  check_word(enc_fsub_s(0, 1, 2), 0x1E223820L)
  check_word(enc_fmul_s(0, 1, 2), 0x1E220820L)
  check_word(enc_fdiv_s(0, 1, 2), 0x1E221820L)
  check_word(enc_fcmpe_d(0, 1), 0x1E612010L)
  check_word(enc_fcmpe_s(0, 1), 0x1E212010L)
  check_word(enc_fcvtzs_w_d(0, 0), 0x1E780000L)
  check_word(enc_fcvtzs_w_s(0, 0), 0x1E380000L)
  check_word(enc_fcvtzs_x_s(0, 0), 0x9E380000L)
  check_word(enc_scvtf_d_w(0, 0), 0x1E620000L)
  check_word(enc_scvtf_s_w(0, 0), 0x1E220000L)
  check_word(enc_scvtf_s_x(0, 0), 0x9E220000L)
  check_word(enc_fcvt_s_d(0, 0), 0x1E624000L)
  check_word(enc_fmov_w_s(0, 0), 0x1E260000L)
  check_word(enc_fmov_s_w(0, 0), 0x1E270000L)
  check_word(enc_fmov_d_x(0, 0), 0x9E670000L)
  check_word(enc_sxtb_sf(false, 0, 1), 0x13001C20L)
  check_word(enc_sxth_sf(false, 0, 1), 0x13003C20L)
  check_word(enc_uxtb_sf(false, 0, 1), 0x53001C20L)
  check_word(enc_uxth_sf(false, 0, 1), 0x53003C20L)
}
