# variadic with mixed float and int varargs

function d $vf(w %n, ...) {
@start
	%ap =l alloc8 40
	vastart %ap
	%r =d copy d_0.0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%r2 =d phi @start %r, @body %r3
	%cmp =w csltw %i2, %n
	jnz %cmp, @body, @end
@body
	%v =d vaarg %ap
	%r3 =d add %r2, %v
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %r2
}
function d $test() {
@start
	%r =d call $vf(w 2, d d_1.0, d d_2.0)
	ret %r
}

