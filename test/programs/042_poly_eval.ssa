# evaluate an array as polynomial coefficients: 1 + 2x + 3x^2 at x=2 = 17

data $c = { w 1, w 2, w 3 }
export
function w $peval(w %x, w %n) {
@start
	%acc = %accw copy 0
	%pow = %poww copy 1
	%i = %iw copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%acc2 =w phi @start %acc, @body %acc3
	%pow2 =w phi @start %pow, @body %pow3
	%c = %cw csltw %i2, %n
	jnz %c, @body, @end
@body
	%idx = %idxl extsw %i2
	%off = %offl mul 4, %idx
	%p = %pl add $c, %off
	%coef = %coefw load %p
	%term = %termw mul %coef, %pow2
	%acc3 = %acc3w add %acc2, %term
	%pow3 = %pow3w mul %pow2, %x
	%i3 = %i3w add %i2, 1
	jmp @loop
@end
	ret %acc2
}