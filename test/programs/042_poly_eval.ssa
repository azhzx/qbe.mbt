# evaluate an array as polynomial coefficients: 1 + 2x + 3x^2 at x=2 = 17

data $c = { w 1, w 2, w 3 }
export
function w $peval(w %x, w %n) {
@start
	%acc =w copy 0
	%pow =w copy 1
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%acc2 =w phi @start %acc, @body %acc3
	%pow2 =w phi @start %pow, @body %pow3
	%c =w csltw %i2, %n
	jnz %c, @body, @end
@body
	%idx =l extsw %i2
	%off =l mul 4, %idx
	%p =l add $c, %off
	%coef =w load %p
	%term =w mul %coef, %pow2
	%acc3 =w add %acc2, %term
	%pow3 =w mul %pow2, %x
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %acc2
}