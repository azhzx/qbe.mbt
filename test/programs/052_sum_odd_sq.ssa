# sum of odd squares up to n

export
function l $sos(l %n) {
@start
	%sum = %suml copy 0
	%i = %il copy 1
@loop
	%i2 =l phi @start %i, @body %i3
	%sum2 =l phi @start %sum, @body %sum3
	%c = %cl csgtl %i2, %n
	jnz %c, @done, @body
@body
	%sq = %sql mul %i2, %i2
	%sum3 = %sum3l add %sum2, %sq
	%i3 = %i3l add %i2, 2
	jmp @loop
@done
	ret %sum2
}