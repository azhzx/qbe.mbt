# sum of odd squares up to n

export
function l $sos(l %n) {
@start
	%sum =l copy 0
	%i =l copy 1
@loop
	%i2 =l phi @start %i, @body %i3
	%sum2 =l phi @start %sum, @body %sum3
	%c =l csgtl %i2, %n
	jnz %c, @done, @body
@body
	%sq =l mul %i2, %i2
	%sum3 =l add %sum2, %sq
	%i3 =l add %i2, 2
	jmp @loop
@done
	ret %sum2
}