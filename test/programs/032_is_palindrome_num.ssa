# palindrome test for a decimal number

export
function w $palin(w %n) {
@start
	%rev =w copy 0
	%t =w copy %n
@loop
	%rev2 =w phi @start %rev, @body %rev3.2
	%t2 =w phi @start %t, @body %t3
	%c =w ceqw %t2, 0
	jnz %c, @chk, @body
@body
	%d =w rem %t2, 10
	%rev3 =w mul %rev2, 10
	%rev3.2 =w add %rev3, %d
	%t3 =w div %t2, 10
	jmp @loop
@chk
	%c2 =w ceqw %rev2, %n
	jnz %c2, @yes, @no
@yes
	ret 1
@no
	ret 0
}