# reverse the 32 bits of a word

export
function w $revb(w %x) {
@start
	%r =w copy 0
	%i =w copy 0
	%xv =w copy %x
@loop
	%r2 =w phi @start %r, @body %r3.2
	%i2 =w phi @start %i, @body %i3
	%x2 =w phi @start %xv, @body %x3
	%c =w csltw %i2, 32
	jnz %c, @body, @done
@body
	%r3 =w shl %r2, 1
	%bit =w and %x2, 1
	%r3.2 =w or %r3, %bit
	%x3 =w shr %x2, 1
	%i3 =w add %i2, 1
	jmp @loop
@done
	ret %r2
}