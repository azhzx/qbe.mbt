# population count (number of set bits)

export
function w $pop(w %x) {
@start
	%c =w copy 0
	%v =w copy %x
@loop
	%c2 =w phi @start %c, @body %c3
	%v2 =w phi @start %v, @body %v3
	%test =w ceqw %v2, 0
	jnz %test, @done, @body
@body
	%bit =w and %v2, 1
	%c3 =w add %c2, %bit
	%v3 =w shr %v2, 1
	jmp @loop
@done
	ret %c2
}