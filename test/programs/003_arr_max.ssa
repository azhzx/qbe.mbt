# maximum of an array of words

data $arr = { w 3, w 7, w 1, w 9, w 4 }
export
function w $max(w %n) {
@start
	%m =w copy 0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @join %i3
	%m2 =w phi @start %m, @join %m3
	%c =w csltw %i2, %n
	jnz %c, @body, @end
@body
	%idx =l extsw %i2
	%off =l mul 4, %idx
	%p =l add $arr, %off
	%v =w load %p
	%c2 =w csgtw %v, %m2
	jnz %c2, @new, @keep
@new
	%mv =w copy %v
	jmp @join
@keep
	%mk =w copy %m2
	jmp @join
@join
	%m3 =w phi @new %mv, @keep %mk
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %m2
}