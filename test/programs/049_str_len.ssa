# string length

data $s = { b "hello", b 0 }
export
function w $len(l %s) {
@start
	%n =w copy 0
@loop
	%n2 =w phi @start %n, @body %n3
	%p2 =l phi @start %s, @body %p3
	%ch =w loadub %p2
	%c =w ceqw %ch, 0
	jnz %c, @done, @body
@body
	%n3 =w add %n2, 1
	%p3 =l add %p2, 1
	jmp @loop
@done
	ret %n2
}