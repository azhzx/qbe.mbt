# find first occurrence of a byte in a string

data $s = { b "hello world", b 0 }
export
function l $find(l %s, w %target) {
@start
	%i =l copy 0
@loop
	%i2 =l phi @start %i, @next %i3
	%p2 =l phi @start %s, @next %p3
	%ch =w loadub %p2
	%c =w ceqw %ch, 0
	jnz %c, @notfound, @chk
@chk
	%c2 =w ceqw %ch, %target
	jnz %c2, @found, @next
@next
	%i3 =l add %i2, 1
	%p3 =l add %p2, 1
	jmp @loop
@found
	ret %i2
@notfound
	ret -1
}