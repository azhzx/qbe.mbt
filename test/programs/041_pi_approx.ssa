# approximate pi via a series: 4*(1 - 1/3 + 1/5 - ...)

export
function d $pi(w %n) {
@start
	%s =d copy d_0.0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @join %i3
	%s2 =d phi @start %s, @join %s3
	%c =w csltw %i2, %n
	jnz %c, @body, @end
@body
	%t =w shl %i2, 1
	%t.2 =w add %t, 1
	%tf =d swtof %t.2
	%term =d div d_1.0, %tf
	%even =w and %i2, 1
	%c2 =w ceqw %even, 0
	jnz %c2, @add, @sub
@add
	%sa =d add %s2, %term
	jmp @join
@sub
	%sb =d sub %s2, %term
	jmp @join
@join
	%s3 =d phi @add %sa, @sub %sb
	%i3 =w add %i2, 1
	jmp @loop
@end
	%r =d mul %s2, d_4.0
	ret %r
}