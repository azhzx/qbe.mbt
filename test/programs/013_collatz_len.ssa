# length of the collatz sequence for n

export
function w $clen(w %n) {
@start
	%len = %lenw copy 1
	%v = %vw copy %n
@loop
	%v2 =w phi @start %v, @join %v3
	%len2 =w phi @start %len, @join %len3
	%c = %cw ceqw %v2, 1
	jnz %c, @done, @body
@body
	%odd = %oddw and %v2, 1
	%c2 = %c2w ceqw %odd, 0
	jnz %c2, @even, @odd
@even
	%ve = %vew shr %v2, 1
	jmp @join
@odd
	%vo = %vow mul %v2, 3
	%vo = %vo.2w add %vo, 1
	jmp @join
@join
	%v3 =w phi @even %ve, @odd %vo.2
	%len3 = %len3w add %len2, 1
	jmp @loop
@done
	ret %len2
}