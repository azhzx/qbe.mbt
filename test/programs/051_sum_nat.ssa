# sum of naturals via a loop

export
function l $sumnat(l %n) {
@start
	%sum = %suml copy 0
	%i = %il copy 1
@loop
	%i2 =l phi @start %i, @body %i3
	%sum2 =l phi @start %sum, @body %sum3
	%c = %cl csgtl %i2, %n
	jnz %c, @done, @body
@body
	%sum3 = %sum3l add %sum2, %i2
	%i3 = %i3l add %i2, 1
	jmp @loop
@done
	ret %sum2
}