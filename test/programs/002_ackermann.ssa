# ackermann(2, 3) exercises deep recursion

export
function w $ack(w %m, w %n) {
@start
	%c =w ceqw %m, 0
	jnz %c, @base, @chk
@base
	%r =w add %n, 1
	ret %r
@chk
	%c2 =w ceqw %n, 0
	jnz %c2, @m0, @both
@m0
	%m1 =w sub %m, 1
	%r1 =w call $ack(w %m1, w 1)
	ret %r1
@both
	%n1 =w sub %n, 1
	%r2 =w call $ack(w %m, w %n1)
	%m2 =w sub %m, 1
	%r3 =w call $ack(w %m2, w %r2)
	ret %r3
}