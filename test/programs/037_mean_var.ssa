# mean of an array of doubles (truncated to int)

data $arr = { d 4607182418800017408, d 4611686018427387904, d 4613937818241073152, d 4616189618054758400 }
export
function w $stats(w %n) {
@start
	%sum =d copy d_0.0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%sum2 =d phi @start %sum, @body %sum3
	%c =w csltw %i2, %n
	jnz %c, @body, @end
@body
	%idx =l extsw %i2
	%off =l mul 8, %idx
	%p =l add $arr, %off
	%v =d load %p
	%sum3 =d add %sum2, %v
	%i3 =w add %i2, 1
	jmp @loop
@end
	%mean =d div %sum2, d_4.0
	%mi =w dtosi %mean
	ret %mi
}