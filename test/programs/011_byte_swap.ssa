# byte swap a 32-bit word

export
function w $bswap(w %x) {
@start
	%b0 = %b0w and %x, 255
	%sh0 = %sh0w shl %b0, 24
	%b1 = %b1w shr %x, 8
	%b1 = %b1.2w and %b1, 255
	%sh1 = %sh1w shl %b1.2, 16
	%b2 = %b2w shr %x, 16
	%b2 = %b2.2w and %b2, 255
	%sh2 = %sh2w shl %b2.2, 8
	%b3 = %b3w shr %x, 24
	%r = %rw or %sh0, %sh1
	%r = %r.2w or %r, %sh2
	%r = %r.3w or %r.2, %b3
	ret %r.3
}