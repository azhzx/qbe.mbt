# byte swap a 32-bit word

export
function w $bswap(w %x) {
@start
	%b0 =w and %x, 255
	%sh0 =w shl %b0, 24
	%b1 =w shr %x, 8
	%b1.2 =w and %b1, 255
	%sh1 =w shl %b1.2, 16
	%b2 =w shr %x, 16
	%b2.2 =w and %b2, 255
	%sh2 =w shl %b2.2, 8
	%b3 =w shr %x, 24
	%r =w or %sh0, %sh1
	%r.2 =w or %r, %sh2
	%r.3 =w or %r.2, %b3
	ret %r.3
}