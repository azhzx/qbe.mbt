# index a 4x4 matrix stored as a flat array

data $mat = { w 1, w 2, w 3, w 4, w 5, w 6, w 7, w 8, w 9, w 10, w 11, w 12, w 13, w 14, w 15, w 16 }
export
function w $at(w %r, w %c) {
@start
	%row =w mul %r, 4
	%idx =w add %row, %c
	%i =l extsw %idx
	%off =l mul 4, %i
	%p =l add $mat, %off
	%v =w load %p
	ret %v
}