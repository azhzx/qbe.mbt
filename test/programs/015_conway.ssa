# next generation of a 1-d cellular automaton bitmask

export
function w $next(w %x) {
@start
	%r =w copy 0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @join %i3
	%r2 =w phi @start %r, @join %r3
	%c =w csltw %i2, 30
	jnz %c, @body, @end
@body
	%sh =w shl 1, %i2
	%l =w sub %i2, 1
	%rsh =w shl 1, %l
	%left =w and %x, %rsh
	%right =w and %x, %rsh
	%mid =w and %x, %sh
	%lr =w or %left, %mid
	%lr.2 =w or %lr, %right
	%c2 =w ceqw %lr.2, %sh
	jnz %c2, @set, @no
@set
	%rs =w or %r2, %sh
	jmp @join
@no
	%rn =w copy %r2
	jmp @join
@join
	%r3 =w phi @set %rs, @no %rn
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %r2
}