# integer/float conversions mixed in a loop

export
function w $conv(w %n) {
@start
	%sum =w copy 0
	%i =w copy 1
@loop
	%i2 =w phi @start %i, @body %i3
	%sum2 =w phi @start %sum, @body %sum3
	%c =w cslew %i2, %n
	jnz %c, @body, @end
@body
	%f =d swtof %i2
	%half =d div %f, d_2.0
	%ri =w dtosi %half
	%sum3 =w add %sum2, %ri
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %sum2
}