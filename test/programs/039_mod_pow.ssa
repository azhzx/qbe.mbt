# modular exponentiation: (base^exp) mod m

export
function w $mpow(w %b, w %e, w %m) {
@start
	%r =w copy 1
	%be =w copy %b
	%ee =w copy %e
@loop
	%r2 =w phi @start %r, @join %r4
	%be2 =w phi @start %be, @join %be3
	%ee2 =w phi @start %ee, @join %ee3
	%c =w ceqw %ee2, 0
	jnz %c, @done, @body
@body
	%odd =w and %ee2, 1
	%c2 =w ceqw %odd, 0
	jnz %c2, @skip, @mul
@mul
	%rm =w mul %r2, %be2
	%rm.2 =w rem %rm, %m
	%rm.3 =w copy %rm.2
	jmp @join
@skip
	%rs =w copy %r2
	jmp @join
@join
	%r4 =w phi @mul %rm.3, @skip %rs
	%bm =w mul %be2, %be2
	%be3 =w rem %bm, %m
	%ee3 =w shr %ee2, 1
	jmp @loop
@done
	ret %r2
}