# bubble sort an array of words

data $arr = { w 5, w 2, w 8, w 1, w 9, w 3 }
export
function w $sort(w %n) {
@start
	%i =w copy 0
	%j =w copy 0
@outer
	%i2 =w phi @start %i, @oend %i3
	%j2 =w phi @start %j, @oend %j3
	%c =w csltw %i2, %n
	jnz %c, @inner, @done
@inner
	%jm =w sub %n, %i2
	%jm2 =w sub %jm, 1
	%c2 =w csltw %j2, %jm2
	jnz %c2, @cmp, @oend
@cmp
	%ji =l extsw %j2
	%joff =l mul 4, %ji
	%jp =l add $arr, %joff
	%a =w load %jp
	%j1 =w add %j2, 1
	%j1i =l extsw %j1
	%j1off =l mul 4, %j1i
	%j1p =l add $arr, %j1off
	%b =w load %j1p
	%c3 =w csgtw %a, %b
	jnz %c3, @swap, @oend
@swap
	storew %b, %jp
	storew %a, %j1p
	jmp @oend
@oend
	%j3 =w add %j2, 1
	%i3 =w add %i2, 1
	jmp @outer
@done
	ret 0
}