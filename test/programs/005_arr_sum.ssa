# sum of an array: 10+20+30+40 = 100

data $arr = { l 10, l 20, l 30, l 40 }
export
function l $sum(w %n) {
@start
	%s =l copy 0
	%i =w copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%s2 =l phi @start %s, @body %s3
	%c =w csltw %i2, %n
	jnz %c, @body, @end
@body
	%idx =l extsw %i2
	%off =l mul 8, %idx
	%p =l add $arr, %off
	%v =l load %p
	%s3 =l add %s2, %v
	%i3 =w add %i2, 1
	jmp @loop
@end
	ret %s2
}