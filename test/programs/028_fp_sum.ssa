# sum a run of doubles

export
function d $fsum(w %n) {
@start
	%s = %sd copy d_0.0
	%i = %iw copy 0
@loop
	%i2 =w phi @start %i, @body %i3
	%s2 =d phi @start %s, @body %s3
	%c = %cw csltw %i2, %n
	jnz %c, @body, @end
@body
	%f = %fd sltof %i2
	%s3 = %s3d add %s2, %f
	%i3 = %i3w add %i2, 1
	jmp @loop
@end
	ret %s2
}