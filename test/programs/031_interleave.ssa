# merge two sorted runs (sum the smaller of each pair)

data $a = { w 1, w 3, w 5 }
data $b = { w 2, w 4, w 6 }
export
function w $merge(w %n) {
@start
	%total = %totalw copy 0
	%i = %iw copy 0
@loop
	%i2 =w phi @start %i, @join %i3
	%t2 =w phi @start %total, @join %t3
	%c = %cw csltw %i2, %n
	jnz %c, @body, @end
@body
	%ia = %ial extsw %i2
	%oa = %oal mul 4, %ia
	%pa = %pal add $a, %oa
	%va = %vaw load %pa
	%ib = %ibl extsw %i2
	%ob = %obl mul 4, %ib
	%pb = %pbl add $b, %ob
	%vb = %vbw load %pb
	%c2 = %c2w csgtw %va, %vb
	jnz %c2, @b, @a
@a
	%ta = %taw add %t2, %va
	jmp @join
@b
	%tb = %tbw add %t2, %vb
	jmp @join
@join
	%t3 =w phi @a %ta, @b %tb
	%i3 = %i3w add %i2, 1
	jmp @loop
@end
	ret %t2
}