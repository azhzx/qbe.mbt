# chain of calls with different argument counts

export
function w $f1(w %x) {
@start
	%a.2.2 =w call $f1(w %n)
	%b.2.2 =w call $f2(w %a.2.2, w 2)
	%c.2.2 =w call $f3(w %a.2.2, w %b.2.2, w 3)
	%r.2.2 =w add %c.2.2, %b.2.2
	ret %r.2.2
}
