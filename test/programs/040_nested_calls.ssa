# chain of calls with different argument counts

export
function w $f1(w %x) {
@start
	%a = %a.4 %a.3 %a.2 %aw call $f1(w %n)
	%b = %b.4 %b.3 %b.2 %bw call $f2(w %a.2, w 2)
	%c = %c.4 %c.3 %c.2 %cw call $f3(w %a.2, w %b.2, w 3)
	%r = %r.4 %r.3 %r.2 %rw add %c.2, %b.2
	ret %r.2
}
