# return max*100 + min

export
function w $minmax(w %a, w %b) {
@start
	%c =w csgtw %a, %b
	jnz %c, @ab, @ba
@ab
	%mx =w copy %a
	%mn =w copy %b
	jmp @join
@ba
	%mx.2 =w copy %b
	%mn.2 =w copy %a
	jmp @join
@join
	%max =w phi @ab %mx, @ba %mx.2
	%min =w phi @ab %mn, @ba %mn.2
	%m =w mul %max, 100
	%r =w add %m, %min
	ret %r
}