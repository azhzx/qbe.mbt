# primality test: is_prime(97) = 1

export
function w $prime(w %n) {
@start
	%c =w cslew %n, 1
	jnz %c, @no, @start2
@start2
	%i =w copy 2
@loop
	%i2 =w phi @start2 %i, @cont %i3
	%sq =w mul %i2, %i2
	%c2 =w csgtw %sq, %n
	jnz %c2, @yes, @body
@body
	%d =w rem %n, %i2
	%c3 =w ceqw %d, 0
	jnz %c3, @no, @cont
@cont
	%i3 =w add %i2, 1
	jmp @loop
@yes
	ret 1
@no
	ret 0
}