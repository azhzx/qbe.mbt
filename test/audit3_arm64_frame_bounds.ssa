# ARM64 frame-size boundary probes: stp/sub/mov/movk prologue forms,
# epilogue ldp/add forms, vararg save-area offsets, a dynamic alloc and
# a global symbol with a byte offset.

function l $a3b_g(l %x) {
@start
	ret %x
}

export function l $a3b_f0(l %n) {
@start
	%p =l alloc16 480
	storel %n, %p
	%q =l call $a3b_g(l %n)
	storel %q, %p
	%z =l call $a3b_g(l %p)
	%r =l add %q, %z
	ret %r
}

