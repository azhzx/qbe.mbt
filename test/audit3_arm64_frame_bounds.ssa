export function l $a3b_va(l %n, ...) {
@start
	%ap =l alloc16 70000
	storel %n, %ap
	vastart %ap
	%x =l vaarg %ap
	%q =l call $a3b_g(l %n)
	%z =l call $a3b_g(l %ap)
	storel %q, %ap
	%r =l add %x, %z
	ret %r
}

export function l $a3b_alloc(l %n, l %sz) {
@start
	%p =l alloc8 %sz
	storel %n, %p
	%q =l call $a3b_g(l %p)
	ret %q
}

data $a3b_glob = { l 1, l 2, l 3 }

export function l $a3b_symoff() {
@start
	%p =l add $a3b_glob, 8
	%x =l loadl %p
	ret %x
}
