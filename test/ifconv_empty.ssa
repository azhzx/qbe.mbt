# A block whose only content is an implicit fall-through jump to the next
# label: if-conversion must see it as an if-then graphlet (C ifgraph orders
# blocks by RPO id, not definition order).

type :magic = align 1 { 0 }

data $ret = { l 0 }

export
function $test(:magic %p) {
@start
	%av =w loadw $a
	%a1 =w add 1, %av
	storew %a1, $a       # increment $a
	%r1 =l loadl $ret    # fetch from $ret
	%p1 =l add %p, -8
	%r2 =l loadl %p1     # get the return address
	storel %r2, $ret     # store it in $ret
	%c =w ceql %r1, %r2
	jnz %c, @fin, @cal
@cal
@fin
	ret
}
