	%t0 =w add %x0, 0
	%t1 =w add %x1, 0
	%t2 =w add %x2, 0
	%t3 =w add %x3, 0
	%t4 =w add %x4, 0
	%t5 =w add %x5, 0
	%t6 =w add %x6, 0
	%t7 =w add %x7, 0
	%t8 =w add %x8, 0
	%t9 =w add %x9, 0
	%t10 =w add %x10, 0
	%t11 =w add %x11, 0
	%r =w add %t0, %t1
	%r =w add %r, %t2
	%r =w add %r, %t3
	%r =w add %r, %t4
	%r =w add %r, %t5
	%r =w add %r, %t6
	%r =w add %r, %t7
	%r =w add %r, %t8
	%r =w add %r, %t9
	%r =w add %r, %t10
	%r =w add %r, %t11
	ret %r
}

