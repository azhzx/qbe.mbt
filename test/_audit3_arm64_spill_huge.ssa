# ARM64 spill slots above the scaled immediate range: a > 64KB frame
# forces the load/store fixarg path (x17/x18 materialization).

function l $a3_arm64_spill_g0() {
@start
	ret 1
}

function l $a3_arm64_spill_g1(l %x) {
@start
	ret %x
}

