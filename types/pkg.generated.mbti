pub fn Ref::rv64_argregs(Self) -> (UInt64, Int32, Int32)
pub fn Ref::rv64_retregs(Self) -> (UInt64, Int32, Int32)
pub fn Ref::slot(Int32) -> Self
pub fn Ref::slot_val(Self) -> Int32
pub fn Ref::tmp(Int32) -> Self
pub fn Ref::tmp_val(Self) -> Int32
pub fn Ref::typ(Int32) -> Self
pub fn Ref::typ_val(Self) -> Int32

pub(all) struct RegHint {
  mut r : Int32
  mut w : Int32
  mut m : UInt64
} derive(@debug.Debug)
pub fn RegHint::default() -> Self

pub struct TargetCfg {
  mut gpr_base : Int32
  mut fpr_base : Int32
  mut ngpr : Int32
  mut nfpr : Int32
  mut fpr_class_base : Int32
  mut post_call_gpr : Int32
  mut post_call_fpr : Int32
  mut rglob_mask : UInt64
  mut rsave : Array[Int32]
  mut memargs : (Op) -> Int32
  mut retregs : (Ref) -> (UInt64, Int32, Int32)
  mut argregs : (Ref) -> (UInt64, Int32, Int32)
}

pub(all) struct Tmp {
  name : String
  uses : Array[Use]
  mut ndef : Int32
  mut nuse : Int32
  mut bid : Int32
  mut cost : Int32
  mut slot : Int32
  mut reg : Int32
  mut cls : Class
  mut hint : RegHint
  mut is_phi : Int32
  mut alias_info : AliasInfo
  mut width : TmpWidth
  mut visit : Int32
} derive(@debug.Debug)
pub fn Tmp::new(String, Class) -> Self

pub(all) enum TmpWidth {
  WFull
  Wsb
  Wub
  Wsh
  Wuh
  Wsw
  Wuw
} derive(Eq, @debug.Debug)
pub fn TmpWidth::code(Self) -> Int32
pub fn TmpWidth::from_code(Int32) -> Self

pub(all) struct Typ {
  mut name : String
  mut dark : Int32
  mut align : Int32
  mut size : Int64
  mut nunion : Int32
  fields : Array[Field]
} derive(Eq, @debug.Debug)
pub fn Typ::compute_layout(Self, Array[Self]) -> Unit
pub fn Typ::new(String) -> Self

pub(all) struct Use {
  kind : UseKind
  blk_id : Int32
  ins_idx : Int32
  arg_num : Int32
} derive(Eq, @debug.Debug)

pub(all) enum UseKind {
  UXXX
  UPhi
  UIns
  UJmp
} derive(Eq, @debug.Debug)

pub enum WasmType {
  Wi32
  Wi64
  Wf32
  Wf64
  WVoid
} derive(Eq, @debug.Debug)

// Type aliases
pub type BlkId = Int32

// Traits
