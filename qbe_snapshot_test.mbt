///|
test "e2e abi: 001_arg1w" {
  let src =
    #|# 1 word arguments (6 GPR, the rest on the stack)
    #|export
    #|function w $callee1(w %a0) {
    #|@start
    #|    %r =w add %a0, 0
    #|    ret %r
    #|}
    #|function w $test() {
    #|@start
    #|    %r =w call $callee1(w 1)
    #|    ret %r
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl callee1
          #|callee1:
          #|	endbr64
          #|	movl %edi, %eax
          #|	ret
          #|.type callee1, @function
          #|.size callee1, .-callee1
          #|/* end function callee1 */
          #|
          #|.text
          #|.balign 16
          #|test:
          #|	endbr64
          #|	pushq %rbp
          #|	movq %rsp, %rbp
          #|	movl $1, %edi
          #|	callq callee1
          #|	leave
          #|	ret
          #|.type test, @function
          #|.size test, .-test
          #|/* end function test */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}

