///|
test "e2e regalloc: 006_callersave" {
  let src =
    #|# values live across a call must survive in callee-save registers
    #|export
    #|function w $callee(w %x) {
    #|@start
    #|    %r =w add 1, %x
    #|    ret %r
    #|}
    #|function w $test(w %a, w %b) {
    #|@start
    #|    %x =w add %a, 1
    #|    %y =w call $callee(w %b)
    #|    %z =w add %x, %y
    #|    ret %z
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl callee
          #|callee:
          #|	endbr64
          #|	movl %edi, %eax
          #|	addl $1, %eax
          #|	ret
          #|.type callee, @function
          #|.size callee, .-callee
          #|/* end function callee */
          #|
          #|.text
          #|.balign 16
          #|test:
          #|	endbr64
          #|	pushq %rbp
          #|	movq %rsp, %rbp
          #|	subq $8, %rsp
          #|	pushq %rbx
          #|	movl %edi, %eax
          #|	movl %esi, %edi
          #|	movl %eax, %ebx
          #|	addl $1, %ebx
          #|	callq callee
          #|	addl %ebx, %eax
          #|	popq %rbx
          #|	leave
          #|	ret
          #|.type test, @function
          #|.size test, .-test
          #|/* end function test */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}

///|
test "e2e regalloc: 010_calleesave" {
  let src =
    #|# several calls in sequence, results kept in registers
    #|export
    #|function w $callee(w %x) {
    #|@start
    #|    %r =w add 1, %x
    #|    ret %r
    #|}
    #|function w $test(w %a0, w %a1, w %a2, w %a3) {
    #|@start
    #|    %r0 =w call $callee(w %a0)
    #|    %r1 =w call $callee(w %a1)
    #|    %r2 =w call $callee(w %a2)
    #|    %r3 =w call $callee(w %a3)
    #|    %r =w add %r0, %r1
    #|    %r =w add %r, %r2
    #|    %r =w add %r, %r3
    #|    ret %r
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl callee
          #|callee:
          #|	endbr64
          #|	movl %edi, %eax
          #|	addl $1, %eax
          #|	ret
          #|.type callee, @function
          #|.size callee, .-callee
          #|/* end function callee */
          #|
          #|.text
          #|.balign 16
          #|test:
          #|	endbr64
          #|	pushq %rbp
          #|	movq %rsp, %rbp
          #|	subq $8, %rsp
          #|	pushq %rbx
          #|	pushq %r12
          #|	pushq %r13
          #|	movl %ecx, %ebx
          #|	movl %edx, %r13d
          #|	movl %esi, %r12d
          #|	callq callee
          #|	movl %r12d, %edi
          #|	movl %eax, %r12d
          #|	callq callee
          #|	movl %r13d, %edi
          #|	movl %eax, %r13d
          #|	callq callee
          #|	movl %ebx, %edi
          #|	movl %eax, %ebx
          #|	callq callee
          #|	movl %r12d, %ecx
          #|	addl %r13d, %ecx
          #|	addl %ebx, %ecx
          #|	addl %ecx, %eax
          #|	popq %r13
          #|	popq %r12
          #|	popq %rbx
          #|	leave
          #|	ret
          #|.type test, @function
          #|.size test, .-test
          #|/* end function test */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}

///|
test "e2e emit: 008_data_zero" {
  let src =
    #|# data section with zero fill
    #|data $z = { b 1, z 64, b 2 }
    #|export
    #|function w $test() {
    #|@start
    #|    ret 0
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.data
          #|.balign 8
          #|z:
          #|	.byte 1
          #|	.fill 64,1,0
          #|	.byte 2
          #|/* end data */
          #|
          #|.text
          #|.balign 16
          #|.globl test
          #|test:
          #|	endbr64
          #|	movl $0, %eax
          #|	ret
          #|.type test, @function
          #|.size test, .-test
          #|/* end function test */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|


        ),
      )
    Err(e) => fail("compile failed")
  }
}

///|
test "e2e emit: 005_data_str" {
  let src =
    #|# data section with strings and a newline escape
    #|data $s = { b "hello\n", b 0 }
    #|data $s2 = { b "tab\there", b 0 }
    #|export
    #|function w $test() {
    #|@start
    #|    ret 0
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.data
          #|.balign 8
          #|s:
          #|	.ascii "hello\n"
          #|	.byte 0
          #|/* end data */
          #|
          #|.data
          #|.balign 8
          #|s2:
          #|	.ascii "tab\there"
          #|	.byte 0
          #|/* end data */
          #|
          #|.text
          #|.balign 16
          #|.globl test
          #|test:
          #|	endbr64
          #|	movl $0, %eax
          #|	ret
          #|.type test, @function
          #|.size test, .-test
          #|/* end function test */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|


        ),
      )
    Err(e) => fail("compile failed")
  }
}

///|
test "e2e programs: 030_gray" {
  let src =
    #|# gray code: n xor (n >> 1)
    #|export
    #|function w $gray(w %n) {
    #|@start
    #|    %s =w shr %n, 1
    #|    %r =w xor %n, %s
    #|    ret %r
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl gray
          #|gray:
          #|	endbr64
          #|	movl %edi, %eax
          #|	shrl $1, %eax
          #|	xorl %edi, %eax
          #|	ret
          #|.type gray, @function
          #|.size gray, .-gray
          #|/* end function gray */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}

///|
test "e2e programs: 054_tower" {
  let src =
    #|# tower of hanoi move count: 2^d - 1
    #|export
    #|function w $hanoi(w %d) {
    #|@start
    #|    %r =w shl 1, %d
    #|    %r.2 =w sub %r, 1
    #|    ret %r.2
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl hanoi
          #|hanoi:
          #|	endbr64
          #|	movl %edi, %ecx
          #|	movl $1, %eax
          #|	shll %cl, %eax
          #|	subl $1, %eax
          #|	ret
          #|.type hanoi, @function
          #|.size hanoi, .-hanoi
          #|/* end function hanoi */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}
