///|
// End-to-end snapshot tests: representative .ssa inputs from test/ compiled
// through the full amd64_sysv pipeline.
//
// Generated by `python tools/gen_snapshot_mbt.py`; expected assembly snapshots
// are filled by `moon test --update` and cross-checked against the reference
// C QBE with `python compare.py --asm`. Do not edit the sources by hand.

///|
test "e2e fold: 001_add_w" {
  let src =
    #|# constant folding of add (2000000000 op 2000000000) in class w
    #|export
    #|function w $fold_add_w() {
    #|@start
    #|    %r =w add 2000000000, 2000000000
    #|    ret %r
    #|}
    #|
  match compile(src) {
    Ok(assembly) =>
      inspect(
        assembly,
        content=(
          #|.text
          #|.balign 16
          #|.globl fold_add_w
          #|fold_add_w:
          #|	endbr64
          #|	movl $4000000000, %eax
          #|	ret
          #|.type fold_add_w, @function
          #|.size fold_add_w, .-fold_add_w
          #|/* end function fold_add_w */
          #|
          #|.section .note.GNU-stack,"",@progbits
          #|

        ),
      )
    Err(e) => fail("compile failed")
  }
}

